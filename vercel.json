{
  "version": 2,
  "buildCommand": "yarn build",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/api"
    }
  ]
}
